DATABASE_URL=postgresql://infradeck:REPLACE_WITH_RANDOM_PASSWORD@localhost:5432/infradeck
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BOOTSTRAP_TOKEN=
# Optional first-deployment administrator. Leave both credentials empty for /setup.
# Provided only to the migration/initialization container, never web/worker.
INFRADECK_INIT_ADMIN_EMAIL=
INFRADECK_INIT_ADMIN_PASSWORD=
INFRADECK_INIT_ADMIN_NAME=
INFRADECK_INIT_WORKSPACE_NAME=
INFRADECK_INIT_TIMEZONE=UTC
INFRADECK_INIT_LOCALE=en
ENCRYPTION_KEY=
# Set to the public corresponding source for the exact deployed revision.
SOURCE_URL=https://github.com/shmelevsergei/infradeck-public/tree/v0.5.0-beta.1
# Unaccepted remote operations: enable only for explicitly authorized test targets.
INFRADECK_EXPERIMENTAL_BACKUPS=false
INFRADECK_EXPERIMENTAL_SSH_ROTATION=false

# Bundled HTTPS: sh install.sh --domain deck.example.com
# Installer sets INFRADECK_DOMAIN, BETTER_AUTH_URL and COMPOSE_FILE together.
# INFRADECK_DOMAIN=deck.example.com
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
