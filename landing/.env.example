# Local browser URLs. Use public HTTPS URLs when deploying externally.
LANDING_BIND=127.0.0.1
LANDING_PORT=4173
LANDING_ORIGIN=http://localhost:4173
LANDING_DEMO_URL=http://localhost:3003
LANDING_REPOSITORY_URL=https://github.com/shmelevsergei/infradeck-public
LANDING_RELEASE_URL=https://github.com/shmelevsergei/infradeck-public/releases
LANDING_DOCS_URL=https://github.com/shmelevsergei/infradeck-public/blob/main/README.md
LANDING_LICENSE_URL=https://github.com/shmelevsergei/infradeck-public/blob/main/LICENSE
LANDING_ENABLE_LEADS=true
LANDING_PRIVACY_URL=
# Server-only values. Set both to enable actual delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional PUBLIC demo-only read-only credentials displayed to visitors. Never use admin credentials.
LANDING_DEMO_EMAIL=
LANDING_DEMO_PASSWORD=
